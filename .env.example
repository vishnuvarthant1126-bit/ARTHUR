# ===== ARTHUR configuration template =====
# Copy to .env and fill in values. NEVER commit .env.

# --- App ---
ARTHUR_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- LLM provider: ollama | openai_compat ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120

# Optional: any OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Embeddings ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Storage ---
DATABASE_URL=sqlite:///./data/arthur.db
VECTOR_STORE_PATH=./data/memory/chroma

# --- Agent safety limits ---
AGENT_MAX_STEPS=8
AGENT_MAX_SECONDS=120

# --- Web search: duckduckgo | searxng | tavily ---
SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=
TAVILY_API_KEY=

# --- Voice (later phases) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto
PIPER_VOICE=en_US-lessac-medium

# --- File access (Phase 14): semicolon-separated absolute paths ---
ALLOWED_DIRECTORIES=
