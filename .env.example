# ===== ARTHUR configuration template =====
# Copy to .env and fill in values. NEVER commit .env.

# --- App ---
ARTHUR_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- LLM provider: ollama | openai_compat ---
LLM_PROVIDER=ollama
# Optional backup used when the main provider fails (e.g. openai_compat). Blank = none.
LLM_FALLBACK_PROVIDER=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120
# Context window (tokens) - prompt + conversation history + reply must fit in it.
LLM_CONTEXT_TOKENS=8192
LLM_REPLY_RESERVE_TOKENS=1024

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Keep the model in GPU memory this long after the last question (Ollama's default is 5m,
# which makes the first answer after a pause ~10 s slower). "-1" = always keep it loaded.
OLLAMA_KEEP_ALIVE=30m

# Optional: any OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio...)
# e.g. OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Short-term (conversation) memory ---
MEMORY_MAX_HISTORY_MESSAGES=40
MEMORY_MAX_SESSIONS=100
MEMORY_SESSION_TTL_MINUTES=240

# --- Long-term memory ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
MEMORY_TOP_K=5
# Similarity threshold (0-1). Measured for nomic-embed-text; re-run
# scripts/calibrate_memory.py if you change the embedding model.
MEMORY_MIN_SCORE=0.55

# --- Documents / RAG ---
DOCUMENTS_PATH=data/documents
DOCUMENTS_MAX_MB=20
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# Measured for nomic-embed-text with scripts/calibrate_rag.py
RAG_MIN_SCORE=0.58

# --- Storage (relative paths are inside the project folder) ---
DATABASE_PATH=data/arthur.db
VECTOR_STORE_PATH=data/memory/chroma

# --- Tools ---
# Levels 0-1 run automatically; level 2 always asks you first; level 3 is never allowed.
TOOLS_AUTO_APPROVE_MAX_LEVEL=1
# Comma-separated tool names to disable, e.g. weather,save_memory
TOOLS_BLOCKED=
TOOLS_DEFAULT_TIMEOUT_SECONDS=10

# --- Agent safety limits ---
AGENT_MAX_STEPS=8
AGENT_MAX_SECONDS=120
# Split multi-part requests into a plan first (true/false) and its total time budget.
AGENT_PLANNING=true
AGENT_PLAN_MAX_SECONDS=240

# --- Web search: duckduckgo (free, no key) | searxng (self-hosted, set SEARXNG_URL) ---
SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=
SEARCH_RATE_LIMIT_PER_MINUTE=10
SEARCH_CACHE_MINUTES=10
# Largest web page read_webpage will download (KB)
WEB_FETCH_MAX_KB=2048

# --- Voice: speech-to-text (faster-whisper) ---
# tiny | base | small | medium - bigger is more accurate but slower. small ~2 s per sentence on CPU.
WHISPER_MODEL=small
# cpu (recommended: the GPU is busy with the LLM) | cuda (needs NVIDIA cuBLAS/cuDNN) | auto
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Spoken language; blank = auto-detect (about 1 s slower)
WHISPER_LANGUAGE=en
VOICE_MAX_SECONDS=60
# Fast model that only checks short clips for "Hey Arthur"
WHISPER_WAKE_MODEL=base.en

# --- Voice: text-to-speech (Piper) ---
# Voices live in data/voices. Download more:
#   python -m piper.download_voices --download-dir data/voices en_US-lessac-medium
TTS_DEFAULT_VOICE=en_GB-alan-medium

# --- File access (Phase 14) ---
# Folders ARTHUR may search, read and (with your confirmation) save into. Semicolon-separated.
# Blank = only Documents\ARTHUR. System folders, hidden files and secrets are ALWAYS blocked.
# Example: C:\Users\you\Documents\ARTHUR;C:\Users\you\Documents;C:\Users\you\Downloads
ALLOWED_DIRECTORIES=
# Where "save the report" puts files by default
FILES_SAVE_DIR=

# --- Browser agent (Phase 15). First time: python -m playwright install chromium ---
BROWSER_ENABLED=true
# false = show the browser window so you can watch ARTHUR click
BROWSER_HEADLESS=true
